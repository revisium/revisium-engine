{
  "name": "@revisium/engine",
  "version": "0.1.0",
  "description": "Revisium version engine — core versioning logic for branches, revisions, tables, and rows",
  "author": "Revisium",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run prisma:migrate:deploy && npm run seed:prod && node --experimental-require-module dist/src/main",
    "lint:ci": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "tsc": "tsc --noEmit",
    "test": "jest --maxWorkers=50% --forceExit --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --silent --maxWorkers=50% --forceExit --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prisma:generate": "prisma generate && npm run prisma:postgenerate",
    "prisma:postgenerate": "echo \"export * from './client';\" > src/__generated__/client/index.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "seed": "ts-node prisma/seed/seed.ts",
    "seed:prod": "node dist/prisma/seed/seed.js",
    "docker:test-container-up": "docker compose -f docker/docker-compose-test.yml up -d --wait",
    "docker:test-container-down": "docker compose -f docker/docker-compose-test.yml down",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.1.11",
    "@swc/core": "^1.12.4",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.4",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.0"
  },
  "jest": {
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2021"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts",
      "!src/__generated__/**",
      "!src/**/__tests__/**",
      "!src/**/index.ts",
      "!src/**/*.module.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 30000
  }
}
