{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "prisma/**/*.{json,prisma,toml,sql}",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
