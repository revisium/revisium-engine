generator client {
  provider        = "prisma-client"
  output          = "../src/__generated__/client"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum VersioningMode {
  current
  cow
}

enum CowDraftTableStatus {
  active
  draft_only
  deleted
}

model Branch {
  id        String     @id
  createdAt DateTime   @default(now())
  isRoot    Boolean    @default(false)
  name      String
  projectId String
  revisions Revision[]
  cowDraftStates CowDraftState[]

  @@unique([name, projectId])
}

model Revision {
  id         String   @id
  sequence   Int      @unique @default(autoincrement())
  createdAt  DateTime @default(now())
  comment    String   @default("")
  isHead     Boolean  @default(false)
  isDraft    Boolean  @default(false)
  isStart    Boolean  @default(false)
  hasChanges Boolean  @default(false)

  branchId String
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Revision?  @relation("parentRevision", fields: [parentId], references: [id], onDelete: SetNull)
  children Revision[] @relation("parentRevision")
  tables   Table[]
  cowTableStates CowRevisionTableState[]

  @@index([branchId])
}

model Table {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  system Boolean @default(false)

  revisions Revision[]
  rows      Row[]

  @@index([id])
}

model Row {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  data       Json
  meta       Json   @default("{}")
  hash       String
  schemaHash String

  tables Table[]

  @@index([data], type: Gin)
  @@index([id])
  @@index([hash])
  @@index([schemaHash])
  @@index([publishedAt])
}

model ProjectVersioningConfig {
  projectId       String         @id
  versioningMode  VersioningMode @default(current)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model CowRevisionTableState {
  revisionId     String
  tableCreatedId String
  tableStateId   String

  revision   Revision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tableState CowTableState @relation(fields: [tableStateId], references: [id], onDelete: Cascade)

  @@id([revisionId, tableCreatedId])
  @@index([tableStateId])
  @@index([tableCreatedId])
}

model CowDraftState {
  branchId        String
  tableCreatedId  String
  tableStateId    String
  status          CowDraftTableStatus @default(active)

  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableState CowTableState @relation(fields: [tableStateId], references: [id], onDelete: Cascade)

  @@id([branchId, tableCreatedId])
  @@index([tableStateId])
  @@index([status])
}

model CowTableState {
  id             String @id
  tableCreatedId String
  chunkCount     Int

  revisionStates CowRevisionTableState[]
  draftStates    CowDraftState[]
  chunks         CowTableStateChunk[]

  @@index([tableCreatedId])
}

model CowTableChunk {
  id String @id

  tableStates CowTableStateChunk[]
  entries     CowChunkEntry[]
}

model CowTableStateChunk {
  tableStateId String
  chunkId      String
  chunkNo      Int

  tableState CowTableState @relation(fields: [tableStateId], references: [id], onDelete: Cascade)
  chunk      CowTableChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([tableStateId, chunkNo])
  @@unique([tableStateId, chunkId])
  @@index([chunkId])
}

model CowChunkEntry {
  chunkId      String
  rowCreatedId String
  rowStateId   String
  isDeleted    Boolean @default(false)

  chunk    CowTableChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  rowState CowRowState   @relation(fields: [rowStateId], references: [id], onDelete: Cascade)

  @@id([chunkId, rowCreatedId])
  @@index([rowStateId])
  @@index([isDeleted])
}

model CowRowState {
  id          String   @id
  rowCreatedId String
  rowId       String
  readonly    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedAt DateTime @default(now())
  data        Json
  meta        Json     @default("{}")
  hash        String
  schemaHash  String

  chunkEntries CowChunkEntry[]

  @@index([rowCreatedId])
  @@index([rowId])
  @@index([data], type: Gin)
  @@index([hash])
  @@index([schemaHash])
  @@index([publishedAt])
}

model TableMigration {
  id                   String    @id @default(cuid())
  revisionId           String
  tableId              String
  sourceTableVersionId String
  shadowTableVersionId String?
  status               String    @default("PENDING")
  phase                String    @default("INIT")
  patches              Json
  previousSchema       Json
  previousSchemaHash   String
  targetSchemaHash     String
  totalRows            Int
  copiedRows           Int       @default(0)
  lastCopiedRowId      String?
  batchSize            Int       @default(1000)
  currentBatch         Int       @default(0)
  totalBatches         Int       @default(0)
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  lastProgressAt       DateTime?
  lockedBy             String?
  lockedAt             DateTime?
  heartbeatAt          DateTime?
  errorMessage         String?
  retryCount           Int       @default(0)
  maxRetries           Int       @default(3)

  @@unique([revisionId, tableId])
  @@index([status])
  @@index([lockedBy])
  @@index([status, heartbeatAt])
}
